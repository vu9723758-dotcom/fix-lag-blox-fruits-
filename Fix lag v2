task.spawn(function()
    if setfpscap then setfpscap(60) end
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    Lighting.Brightness = 0
    Lighting:ClearAllChildren() -- Tiêu hủy tức khắc toàn bộ hiệu ứng ánh sáng
    
    -- Tối ưu biển
    local Terrain = Workspace:FindFirstChildOfClass("Terrain")
    if Terrain then
        Terrain.WaterWaveSize = 0
        Terrain.WaterWaveSpeed = 0
        Terrain.WaterReflectance = 0
        Terrain.WaterTransparency = 1
    end

    local function IsEntity(obj)
        local current = obj.Parent
        local depth = 0
        while current and current ~= Workspace and depth < 3 do
            if current:FindFirstChildOfClass("Humanoid") then return true end
            current = current.Parent
            depth = depth + 1
        end
        return false
    end

    -- THUẬT TOÁN TIÊU HỦY MỚI (DESTROY)
    local function DeepDestroyMap(obj)
        if not obj then return end
        if obj:IsA("Terrain") then return end
        if IsEntity(obj) then return end

        if obj:IsA("BasePart") or obj:IsA("MeshPart") then
            if not obj.CanCollide then
                -- NẾU KHÔNG CÓ VA CHẠM -> TIÊU HỦY VĨNH VIỄN KHỎI BỘ NHỚ
                pcall(function() obj:Destroy() end)
            else
                -- NẾU CÓ VA CHẠM -> ÉP TÀNG HÌNH & XÓA MỌI ĐỨA CON (Texture, Decal, Mesh...)
                obj.Transparency = 1
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
                obj.CastShadow = false
                
                for _, child in ipairs(obj:GetChildren()) do
                    if not child:IsA("TouchTransmitter") then -- Giữ lại Touch để không kẹt quest/portals
                        pcall(function() child:Destroy() end)
                    end
                end
            end
        else
            -- Tiêu hủy vĩnh viễn các file đồ họa khác (Particle, Âm thanh map, v.v.)
            if not obj:IsA("Humanoid") and not obj:IsA("Model") and not obj:IsA("Folder") then
                pcall(function() obj:Destroy() end)
            end
        end
    end

    -- Chạy xóa mẻ (Tránh văng game do quét quá nhanh)
    local allDescendants = Workspace:GetDescendants()
    for i, obj in ipairs(allDescendants) do
        DeepDestroyMap(obj)
        if i % 300 == 0 then task.wait() end 
    end

    Workspace.DescendantAdded:Connect(DeepDestroyMap)
end)
