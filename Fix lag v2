-- PHẦN 2: BẢNG HIỂN THỊ FPS (GIỮA MÀN HÌNH & KÉO THẢ ĐƯỢC)
-- ==========================================================
local FPSFrame = Instance.new("Frame")
FPSFrame.Size = UDim2.new(0, 110, 0, 35)
FPSFrame.Position = UDim2.new(0.5, 0, 0.5, 0) -- Giữa màn hình
FPSFrame.AnchorPoint = Vector2.new(0.5, 0.5)
FPSFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
FPSFrame.BackgroundTransparency = 0.3
FPSFrame.Active = true
FPSFrame.Visible = false
FPSFrame.Parent = MainGui

Instance.new("UICorner", FPSFrame).CornerRadius = UDim.new(0, 8)
local FPSStroke = Instance.new("UIStroke", FPSFrame)
FPSStroke.Color = Color3.fromRGB(0, 200, 0)
FPSStroke.Thickness = 1.5

local FPSLabel = Instance.new("TextLabel")
FPSLabel.Size = UDim2.new(1, 0, 1, 0)
FPSLabel.BackgroundTransparency = 1
FPSLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
FPSLabel.Font = Enum.Font.GothamBlack
FPSLabel.TextSize = 16
FPSLabel.Text = "FPS: --"
FPSLabel.Parent = FPSFrame

-- Kéo thả khung FPS (Hỗ trợ cả chuột và cảm ứng điện thoại)
local dragging, dragInput, dragStart, startPos
FPSFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = FPSFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
FPSFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        FPSFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Thuật toán đo FPS
local fpsOn = false
local frames = 0
RunService.RenderStepped:Connect(function() frames = frames + 1 end)

task.spawn(function()
    while task.wait(1) do
        if fpsOn then FPSLabel.Text = "FPS: " .. frames end
        frames = 0
    end
end)

BtnFPS.MouseButton1Click:Connect(function()
    fpsOn = not fpsOn
    FPSFrame.Visible = fpsOn
    BtnFPS.Text = fpsOn and "FPS: ON" or "FPS: OFF"
    BtnFPS.BackgroundColor3 = fpsOn and Color3.fromRGB(0, 130, 0) or Color3.fromRGB(30, 30, 30)
end)

-- Chức năng Màn Đen
