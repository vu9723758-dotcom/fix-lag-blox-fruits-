    BlackFrame.Visible = blackOn
    BtnBlack.Text = blackOn and "Màn Đen: ON" or "Màn Đen: OFF"
    BtnBlack.BackgroundColor3 = blackOn and Color3.fromRGB(150, 0, 0) or Color3.fromRGB(30, 30, 30)
    pcall(function() RunService:Set3dRenderingEnabled(not blackOn) end)
end)

-- ==========================================================
-- PHẦN 3: TỐI ƯU HÓA HỆ THỐNG & XÓA MAP TRIỆT ĐỂ
-- ==========================================================
task.spawn(function()
    pcall(function() if setfpscap then setfpscap(60) end end)
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 0
        for _, v in ipairs(Lighting:GetChildren()) do
            if not v:IsA("Sky") then v:Destroy() end
        end
    end)
    
    -- Tối ưu nước biển
    pcall(function()
        local Terrain = Workspace:FindFirstChildOfClass("Terrain")
        if Terrain then
            Terrain.WaterWaveSize = 0
            Terrain.WaterWaveSpeed = 0
            Terrain.WaterReflectance = 0
            Terrain.WaterTransparency = 1
        end
    end)

    local function IsEntity(obj)
        local current = obj.Parent
        local depth = 0
        while current and current ~= Workspace and depth < 3 do
            if current:FindFirstChildOfClass("Humanoid") then return true end
            current = current.Parent
            depth = depth + 1
        end
        return false
    end

    local function DeepDestroyMap(obj)
        if not obj then return end
        if obj:IsA("Terrain") then return end
        if IsEntity(obj) then return end

        pcall(function()
            if obj:IsA("BasePart") or obj:IsA("MeshPart") then
                if not obj.CanCollide then
                    obj:Destroy()
                else
                    obj.Transparency = 1
                    obj.Material = Enum.Material.SmoothPlastic
                    obj.Reflectance = 0
                    obj.CastShadow = false
                    for _, child in ipairs(obj:GetChildren()) do
                        if not child:IsA("TouchTransmitter") then
                            child:Destroy()
                        end
                    end
                end
            else
                if not obj:IsA("Humanoid") and not obj:IsA("Model") and not obj:IsA("Folder") then
                    obj:Destroy()
                end
            end
        end)
    end

    local allDescendants = Workspace:GetDescendants()
    for i, obj in ipairs(allDescendants) do
        DeepDestroyMap(obj)
        if i % 300 == 0 then task.wait() end 
    end

    Workspace.DescendantAdded:Connect(DeepDestroyMap)
end)
