-- ==========================================================
-- PHẦN 2: THỰC THI TỐI ƯU HÓA NGẦM (KHÔNG GÂY LAG)
-- ==========================================================
task.spawn(function()
    -- Ép FPS 60 và Cấu hình siêu thấp
    if setfpscap then setfpscap(60) end
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    
    -- Xóa toàn bộ hiệu ứng ánh sáng
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    Lighting.Brightness = 0
    for _, v in pairs(Lighting:GetDescendants()) do
        if v:IsA("PostEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("DepthOfFieldEffect") then
            pcall(function() v:Destroy() end)
        end
    end

    -- Tối ưu Nước biển (Loại bỏ gợn sóng và phản chiếu)
    local Terrain = Workspace:FindFirstChildOfClass("Terrain")
    if Terrain then
        Terrain.WaterWaveSize = 0
        Terrain.WaterWaveSpeed = 0
        Terrain.WaterReflectance = 0
    end

    -- Từ điển các vật thể gây lag cần xóa
    local badClasses = {
        ["Decal"] = true, ["Texture"] = true, ["ParticleEmitter"] = true, 
        ["Trail"] = true, ["Fire"] = true, ["Smoke"] = true, 
        ["Sparkles"] = true, ["Explosion"] = true, ["PointLight"] = true, 
        ["SpotLight"] = true, ["SurfaceLight"] = true, ["SpecialMesh"] = true
    }

    -- Thuật toán kiểm tra Humanoid siêu tốc (Giới hạn 3 lớp để tránh tốn CPU)
    local function IsEntity(obj)
        local current = obj.Parent
        local depth = 0
        while current and current ~= Workspace and depth < 3 do
            if current:FindFirstChildOfClass("Humanoid") then return true end
            current = current.Parent
            depth = depth + 1
        end
        return false
    end

    -- Hàm xử lý tàng hình 100% Map
    local function OptimizePart(obj)
        if not obj then return end
        if obj:IsA("Terrain") then return end -- Giữ lại nước biển
        if IsEntity(obj) then return end -- Giữ lại Quái, Boss, Người chơi

        if obj:IsA("BasePart") then
            obj.Transparency = 1 -- 100% tàng hình
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
            obj.CastShadow = false
        elseif badClasses[obj.ClassName] then
            pcall(function() obj:Destroy() end)
        end
    end

    -- Quét toàn bộ Map từ từ để tránh đứng game (Chia mẻ)
    local allDescendants = Workspace:GetDescendants()
    for i, obj in ipairs(allDescendants) do
        OptimizePart(obj)
        -- Cứ xử lý 500 vật thể thì nghỉ 1 nhịp để tránh nghẽn luồng UI
        if i % 500 == 0 then task.wait() end 
    end

    -- Tự động tối ưu các vật thể mới xuất hiện (Skill, quái mới spawn...)
    Workspace.DescendantAdded:Connect(OptimizePart)
end)
